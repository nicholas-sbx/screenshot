[Desktop Entry]
Type=Application
Name=Flatshot screen grabber
Comment=Lets Flatshot capture the screen through KWin's screenshot API
Exec=/usr/lib/flatshot/flatshot-kwin-grab
NoDisplay=true
Terminal=false
# KWin only serves its screenshot API to executables named in a desktop
# file with this key; this grants it to the helper binary alone.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
