#!/usr/bin/python3
# Launcher for distro packages: the app lives in /usr/share/flatshot and
# runs on the distro's PyQt6 unless FLATSHOT_QT says otherwise.
import os
import sys

os.environ.setdefault("FLATSHOT_QT", "pyqt6")
sys.path.insert(0, "/usr/share/flatshot")

from flatshot.app import main  # noqa: E402

sys.exit(main())
